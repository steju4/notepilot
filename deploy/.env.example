# Copy to deploy/.env; credentials stay in a separate file outside Git/the image.
NOTEPILOT_DOMAIN=notepilot.stengele-home.de
NOTEPILOT_PROXY_NETWORK=docker_proxy
# Absolute host path, read-only Docker Compose secret. Owner UID 10001, mode 0600.
NOTEPILOT_AUTH_SECRET_FILE=/etc/notepilot/basic-auth.json
# Your server: four cores, ~7.1 GiB RAM; reserve resources for the other services.
NOTEPILOT_CPUS=2
NOTEPILOT_MEMORY=4g
