# Copy to deploy/.env; never commit that file.
NOTEPILOT_DOMAIN=notepilot.stengele-home.de
NOTEPILOT_PROXY_NETWORK=DEIN_BESTEHENDES_NPM_NETZWERK
# Hostname without https://, copied from Cloudflare Zero Trust settings.
NOTEPILOT_ACCESS_TEAM_DOMAIN=DEIN_TEAM.cloudflareaccess.com
# Additional settings of the self-hosted Cloudflare Access application.
NOTEPILOT_ACCESS_AUD=DEINE_APPLICATION_AUD
# Exact email(s), also restricted by the Cloudflare Allow policy. No "Everyone".
NOTEPILOT_ACCESS_EMAILS=DEINE_EMAIL@example.com
# Runtime limits; leave RAM for Vaultwarden, NPM and other services.
NOTEPILOT_CPUS=4
NOTEPILOT_MEMORY=4g
