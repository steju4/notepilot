# Optional. Export before starting; .env is not automatically loaded.
# NOTEPILOT_DATA_DIR=/path/to/local/notepilot-data
# NOTEPILOT_MAX_UPLOAD_MB=40
# NOTEPILOT_OMR_TIMEOUT=900
# NOTEPILOT_OMR_PYTHON=/path/to/.omr-venv/bin/python

# Optional hosted test instance; use only on a host you explicitly control.
# NOTEPILOT_HOSTED_PREVIEW=1
# NOTEPILOT_ALLOWED_HOSTS=your-exact-hostname.example
